{
    "version": "2.0.0",
    "tasks": [

        // ── Start the LegalAI Express server ──
        // Used as a preLaunchTask so Chrome waits for the server to be ready
        {
            "label": "start-server",
            "type": "shell",
            "command": "node server.js",
            "options": {
                "cwd": "${workspaceFolder}/server",
                "env": {
                    "NODE_ENV": "development",
                    "PORT": "5000"
                }
            },
            "isBackground": true,
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "label": "LegalAI Server",
                "showReuseMessage": false,
                "clear": true
            },
            // Wait until the server prints the ready message before continuing
            "problemMatcher": {
                "owner": "legalai-server",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Starting.*|^.*LegalAI.*",
                    "endsPattern": "^.*running on http://localhost:5000.*"
                }
            }
        },

        // ── Install server npm dependencies ──
        {
            "label": "install-deps",
            "type": "shell",
            "command": "npm install",
            "options": {
                "cwd": "${workspaceFolder}/server"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },

        // ── Restart server (kill existing + restart) ──
        {
            "label": "restart-server",
            "type": "shell",
            "command": "npx kill-port 5000 2>$null; node server.js",
            "options": {
                "cwd": "${workspaceFolder}/server",
                "env": {
                    "NODE_ENV": "development",
                    "PORT": "5000"
                }
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "label": "LegalAI Server (Restarted)",
                "clear": true
            },
            "problemMatcher": {
                "owner": "legalai-server",
                "pattern": { "regexp": "^$" },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*LegalAI.*",
                    "endsPattern": "^.*running on http://localhost:5000.*"
                }
            }
        }

    ]
}
